# IP/имя хоста сервера (используется в Keycloak issuer и в Docker build)
SERVER_IP=192.168.1.40

# PostgreSQL (docker-compose)
POSTGRES_DB=svdb
POSTGRES_USER=postgres
# Обязательно переопредели в продакшене
POSTGRES_PASSWORD=12345

# Keycloak bootstrap-админ
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Обязательно переопредели в продакшене
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# CORS (разрешённые origins фронтенда, через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Vite build-переменные фронтенда
VITE_API_URL=/
