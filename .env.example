# IP/имя хоста сервера. Нужно только dev-прокси Vite (npm run dev) и build-аргументам;
# в рантайме nginx принимает любой Host, поэтому на доступ из сети не влияет.
SERVER_IP=127.0.0.1

# Публичный URL, по которому браузер открывает Keycloak (обычно origin фронтенда).
# Keycloak доступен снаружи только через nginx фронтенда: /realms/...
KEYCLOAK_PUBLIC_URL=http://localhost:5174
KEYCLOAK_ADMIN_URL=http://127.0.0.1:8080

# --- Доступ из локальной сети (у сервера динамический IP) ---
# KEYCLOAK_PUBLIC_URL = тот же origin, который сотрудники вводят в браузере.
# От него зависит iss в токенах и ссылки на страницу входа Keycloak, поэтому
# localhost тут не работает для других машин. При смене адреса перепубликовать:
#   ./scripts/set-lan-origin.sh http://printsv.local:5174
# Предпочтительно имя, а не IP: IP меняется, имя — нет. Варианты имени:
#   mDNS (Linux/Windows/macOS клиент без настройки): hostname.local  (avahi-daemon на сервере)
#   локальный DNS роутера/Windows DNS или запись в C:\Windows\System32\drivers\etc\hosts
# Если имени нет — можно работать по IP: тогда после каждой смены IP перезапускай keycloak
# и api-gateway с новым KEYCLOAK_PUBLIC_URL (или используй резервирование адреса в DHCP).
# KEYCLOAK_PUBLIC_URL=http://printsv.local:5174

# PostgreSQL (docker-compose). Пароль обязателен, значение по умолчанию отсутствует.
POSTGRES_DB=svdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Keycloak bootstrap-админ (только master realm). Пароль обязателен.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Confidential client для Keycloak Admin API (синхронизация сотрудников).
# Для dev/e2e используется realm-export.dev.json, где секрет = order-service-secret.
KEYCLOAK_ADMIN_CLIENT_ID=order-service
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# Учётные данные для Keycloak Admin REST API (синхронизация сотрудников employee-service).
# По умолчанию переиспользуются KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD master realm:
# service-account клиента print-sv realm-management ролей не имеет и получает 403.
# Задайте отдельно, только если нужен другой администратор.
# KEYCLOAK_ADMIN_MASTER_USERNAME=admin
# KEYCLOAK_ADMIN_MASTER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Какой realm импортировать при старте Keycloak:
#   ./keycloak/realm-export.json     — production-safe (без пользователей и секретов)
#   ./keycloak/realm-export.dev.json — dev/e2e (демо-пользователи, только локально)
KEYCLOAK_REALM_IMPORT=./keycloak/realm-export.json

# CORS (разрешённые origins фронтенда, через запятую). Используется api-gateway
# (Spring: allowedOriginPatterns — поддерживает маски) и Keycloak (KC_HTTP_CORS_ALLOWED_ORIGINS).
# Маски вида http://192.168.*:5174 нужны, когда в сети обращаются по меняющемуся IP.
# Keycloak маски не распознаёт (у него точное сравнение), но SPA обращается к Keycloak
# через тот же origin (nginx проксирует /realms/), поэтому CORS Keycloak в этой схеме
# не участвует — важен именно api-gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://192.168.*:5174,http://10.*:5174,http://*.local:5174

# Vite build-переменные фронтенда
VITE_API_URL=/

# Tenant routing (мастер-база для маршрутизации по компаниям)
# APP_TENANT_MASTER_URL=jdbc:postgresql://postgres:5432/svdb
# APP_TENANT_USERNAME=postgres
# APP_TENANT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
